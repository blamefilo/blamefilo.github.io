o_bolt/configuration-6","page_id":"/docs/free_resources/filo_bolt/configuration","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/configuration#notes","content":"`OutlineColor` uses the same RGBA range (0–255) as `SetEntityDrawOutlineColor`."},"320":{"id":"/docs/free_resources/filo_bolt/configuration-7","page_id":"/docs/free_resources/filo_bolt/configuration","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/configuration#notes","content":"`OneAtATime` only blocks the *start* of a new rotation — it does not cancel an animation already in progress."},"321":{"id":"/docs/free_resources/filo_bolt/examples","page_id":"/docs/free_resources/filo_bolt/examples","type":"page","content":"Examples","breadcrumbs":["Docs","Free Resources","filo_bolt"],"tags":[],"url":"/docs/free_resources/filo_bolt/examples"},"322":{"id":"/docs/free_resources/filo_bolt/examples-0","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples","content":"Common usage patterns for filo_bolt."},"323":{"id":"/docs/free_resources/filo_bolt/examples-1","page_id":"/docs/free_resources/filo_bolt/examples","type":"heading","tags":[],"url":"/docs/free_resources/filo_bolt/examples#loosen-a-wheel","content":"Loosen a wheel"},"324":{"id":"/docs/free_resources/filo_bolt/examples-2","page_id":"/docs/free_resources/filo_bolt/examples","type":"heading","tags":[],"url":"/docs/free_resources/filo_bolt/examples#tighten-after-fitting-a-wheel","content":"Tighten after fitting a wheel"},"325":{"id":"/docs/free_resources/filo_bolt/examples-3","page_id":"/docs/free_resources/filo_bolt/examples","type":"heading","tags":[],"url":"/docs/free_resources/filo_bolt/examples#passing-a-bone-index","content":"Passing a bone index"},"326":{"id":"/docs/free_resources/filo_bolt/examples-4","page_id":"/docs/free_resources/filo_bolt/examples","type":"heading","tags":[],"url":"/docs/free_resources/filo_bolt/examples#checking-the-result-in-a-job-flow","content":"Checking the result in a job flow"},"327":{"id":"/docs/free_resources/filo_bolt/examples-5","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples#loosen-a-wheel","content":"The most common use case — called before removing a tyre or wheel."},"328":{"id":"/docs/free_resources/filo_bolt/examples-6","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples#tighten-after-fitting-a-wheel","content":"Called after a new wheel has been attached. `canCancel = false` forces the player to complete the task."},"329":{"id":"/docs/free_resources/filo_bolt/examples-7","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples#passing-a-bone-index","content":"If your resource works with bone indices rather than names, pass the index directly — `filo_bolt` resolves it internally."},"330":{"id":"/docs/free_resources/filo_bolt/examples-8","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples#checking-the-result-in-a-job-flow","content":"`Start` returns a plain boolean, so it fits cleanly into any sequential job logic."},"331":{"id":"/docs/free_resources/filo_bolt/examples-9","page_id":"/docs/free_resources/filo_bolt/examples","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/examples#checking-the-result-in-a-job-flow","content":"Always call `Start` inside a `CreateThread`. It blocks via `Citizen.Await` and will freeze your script if called outside a thread."},"332":{"id":"/docs/free_resources/filo_bolt/export","page_id":"/docs/free_resources/filo_bolt/export","type":"page","content":"Export","breadcrumbs":["Docs","Free Resources","filo_bolt"],"tags":[],"url":"/docs/free_resources/filo_bolt/export"},"333":{"id":"/docs/free_resources/filo_bolt/export-0","page_id":"/docs/free_resources/filo_bolt/export"