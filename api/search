type=\"{\n  vehicle: {\n    description: &#x22;Entity handle of the vehicle the wheel belongs to.&#x22;,\n    type: &#x22;integer&#x22;,\n    required: true,\n  },\n  wheelBone: {\n    description: 'Bone name (&#x22;wheel_lf&#x22;, &#x22;wheel_rf&#x22;, &#x22;wheel_lr&#x22;, &#x22;wheel_rr&#x22;) or a numeric bone index. If a bone index is passed it will be resolved to the matching name automatically.',\n    type: &#x22;string | integer&#x22;,\n    required: true,\n  },\n  lugnutCount: {\n    description: &#x22;How many bolt entities to spawn around the wheel.&#x22;,\n    type: &#x22;integer&#x22;,\n    default: &#x22;5&#x22;,\n  },\n  isTightening: {\n    description: &#x22;Direction of rotation. true rotates clockwise (tighten) and locks the bolt on completion. false rotates counter-clockwise (loosen) and enables physics so the bolt falls away.&#x22;,\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n  },\n  canCancel: {\n    description: &#x22;Whether the player can exit the minigame early by pressing Escape or Backspace.&#x22;,\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n  },\n}\"\n/>"},"342":{"id":"/docs/free_resources/filo_bolt/export-9","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"Value"},"343":{"id":"/docs/free_resources/filo_bolt/export-10","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"Meaning"},"344":{"id":"/docs/free_resources/filo_bolt/export-11","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"`true`"},"345":{"id":"/docs/free_resources/filo_bolt/export-12","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"All bolts were successfully rotated"},"346":{"id":"/docs/free_resources/filo_bolt/export-13","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"`false`"},"347":{"id":"/docs/free_resources/filo_bolt/export-14","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"The player cancelled before finishing"},"348":{"id":"/docs/free_resources/filo_bolt/export-15","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"Bone name"},"349":{"id":"/docs/free_resources/filo_bolt/export-16","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"Position"},"350":{"id":"/docs/free_resources/filo_bolt/export-17","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"`wheel_lf`"},"351":{"id":"/docs/free_resources/filo_bolt/export-18","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"Front-left"},"352":{"id":"/docs/free_resources/filo_bolt/export-19","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"`wheel_rf`"},"353":{"id":"/docs/free_resources/filo_bolt/export-20","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"Front-right"},"354":{"id":"/docs/free_resources/filo_bolt/export-21","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#valid-wheel-bones","content":"`wheel_lr`"},"355":{"id":"/docs/free_resour